    "system-proxy.error.recovery-failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original proxy settings could not be restored. Keep the engine running and use Restore Network Settings." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法恢复原始代理设置。请保持内核运行并使用“恢复网络设置”。" } } } },

    "system-proxy.error.local-proxy-unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Target-owned local sing-box mixed proxy is not listening on its recorded dynamic port." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Target 自己启动的本地 sing-box mixed 代理未监听其记录的动态端口。" } } } },

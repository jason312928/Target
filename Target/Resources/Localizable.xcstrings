    "system-proxy.error.local-proxy-unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local sing-box mixed proxy is not listening on 127.0.0.1:2080." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地 sing-box mixed 代理未监听 127.0.0.1:2080。" } } } },

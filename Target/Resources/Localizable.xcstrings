    "system-proxy.error.snapshot-failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The proxy recovery snapshot could not be read or saved safely. Target recovery is unavailable until it can be verified." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法安全读取或保存代理恢复快照。在快照得到验证前，Target 恢复操作不可用。" } } } },
    "system-proxy.error.verification-failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS did not report the expected proxy settings. Original settings were restored." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未报告预期的代理设置，原始设置已恢复。" } } } },

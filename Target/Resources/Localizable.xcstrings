    "system-proxy.error.external-modification-conflict" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Network settings changed outside Target; recovery was stopped." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网络设置已被 Target 外部修改，恢复已停止。" } } } },

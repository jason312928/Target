    "system-proxy.error.verification-failed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS did not report the expected proxy settings. Original settings were restored." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未报告预期的代理设置，原始设置已恢复。" } } } },
